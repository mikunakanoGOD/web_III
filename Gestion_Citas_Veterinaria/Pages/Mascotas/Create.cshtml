@page
@model Gestion_Citas_Veterinaria.Pages.Mascotas.CreateModel

@{
    ViewData["Title"] = "Nueva Mascota";
}

<h2>Nueva Mascota</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Mascota.PropietarioId" class="form-label">Propietario</label>
                <select asp-for="Mascota.PropietarioId" asp-items="Model.PropietariosSelect" class="form-select">
                    <option value="">-- Seleccione un propietario --</option>
                </select>
                <span asp-validation-for="Mascota.PropietarioId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Mascota.Nombre" class="form-label"></label>
                <input asp-for="Mascota.Nombre" class="form-control" />
                <span asp-validation-for="Mascota.Nombre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Mascota.Especie" class="form-label"></label>
                <input asp-for="Mascota.Especie" class="form-control" />
                <span asp-validation-for="Mascota.Especie" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Mascota.Raza" class="form-label"></label>
                <input asp-for="Mascota.Raza" class="form-control" />
                <span asp-validation-for="Mascota.Raza" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Mascota.FechaNacimiento" class="form-label"></label>
                <input asp-for="Mascota.FechaNacimiento" class="form-control" type="date" />
                <span asp-validation-for="Mascota.FechaNacimiento" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="Mascota.Activo" class="form-check-input" />
                <label asp-for="Mascota.Activo" class="form-check-label">Activa</label>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
