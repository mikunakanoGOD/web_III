@page "{id:int}"
@model Gestion_Citas_Veterinaria.Pages.Mascotas.DeleteModel

@{
    ViewData["Title"] = "Eliminar Mascota";
}

<h2>¿Eliminar esta mascota?</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Mascota.Nombre</dd>

    <dt class="col-sm-3">Especie</dt>
    <dd class="col-sm-9">@Model.Mascota.Especie</dd>

    <dt class="col-sm-3">Propietario</dt>
    <dd class="col-sm-9">@Model.Mascota.Propietario?.Nombre @Model.Mascota.Propietario?.Apellidos</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Mascota.Id" />
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
</form>
