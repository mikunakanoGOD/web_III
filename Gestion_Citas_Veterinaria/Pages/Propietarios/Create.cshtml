@page
@model Gestion_Citas_Veterinaria.Pages.Propietarios.CreateModel

@{
    ViewData["Title"] = "Nuevo Propietario";
}

<h2>Nuevo Propietario</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Propietario.Nombre" class="form-label"></label>
                <input asp-for="Propietario.Nombre" class="form-control" />
                <span asp-validation-for="Propietario.Nombre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Propietario.Apellidos" class="form-label"></label>
                <input asp-for="Propietario.Apellidos" class="form-control" />
                <span asp-validation-for="Propietario.Apellidos" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Propietario.Telefono" class="form-label"></label>
                <input asp-for="Propietario.Telefono" class="form-control" />
                <span asp-validation-for="Propietario.Telefono" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Propietario.Email" class="form-label"></label>
                <input asp-for="Propietario.Email" class="form-control" />
                <span asp-validation-for="Propietario.Email" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="Propietario.Activo" class="form-check-input" />
                <label asp-for="Propietario.Activo" class="form-check-label">Activo</label>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
