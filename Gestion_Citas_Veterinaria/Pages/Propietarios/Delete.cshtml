@page "{id:int}"
@model Gestion_Citas_Veterinaria.Pages.Propietarios.DeleteModel

@{
    ViewData["Title"] = "Eliminar Propietario";
}

<h2>¿Eliminar este propietario?</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Propietario.Nombre</dd>

    <dt class="col-sm-3">Apellidos</dt>
    <dd class="col-sm-9">@Model.Propietario.Apellidos</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Propietario.Email</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Propietario.Id" />
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
</form>
