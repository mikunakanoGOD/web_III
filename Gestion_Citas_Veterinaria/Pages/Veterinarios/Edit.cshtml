@page "{id:int}"
@model Gestion_Citas_Veterinaria.Pages.Veterinarios.EditModel

@{
    ViewData["Title"] = "Editar Veterinario";
}

<h2>Editar Veterinario</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Veterinario.Id" />

            <div class="mb-3">
                <label asp-for="Veterinario.Nombre" class="form-label"></label>
                <input asp-for="Veterinario.Nombre" class="form-control" />
                <span asp-validation-for="Veterinario.Nombre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Veterinario.Apellidos" class="form-label"></label>
                <input asp-for="Veterinario.Apellidos" class="form-control" />
                <span asp-validation-for="Veterinario.Apellidos" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Veterinario.Especialidad" class="form-label"></label>
                <input asp-for="Veterinario.Especialidad" class="form-control" />
                <span asp-validation-for="Veterinario.Especialidad" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Veterinario.Telefono" class="form-label"></label>
                <input asp-for="Veterinario.Telefono" class="form-control" />
                <span asp-validation-for="Veterinario.Telefono" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="Veterinario.Activo" class="form-check-input" />
                <label asp-for="Veterinario.Activo" class="form-check-label">Activo</label>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
