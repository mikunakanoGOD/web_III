@{
    ViewData["Title"] = "Dashboard - Administrador";
    var usuario = ViewBag.Usuario as gestion_biblioteca.ViewModels.UsuarioSesionViewModel;
}

<div class="container-fluid py-4">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Panel de Administrador</h2>
            <p class="text-muted mb-0">Bienvenido, @usuario?.NombreCompleto</p>
        </div>
        <span class="badge bg-danger fs-6 px-3 py-2">Administrador</span>
    </div>

    <!-- Tarjetas de estadísticas -->
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 fs-3">👥</div>
                    <div>
                        <div class="fs-2 fw-bold text-primary">@ViewBag.TotalUsuarios</div>
                        <div class="text-muted small">Total Usuarios</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 fs-3">📚</div>
                    <div>
                        <div class="fs-2 fw-bold text-success">@ViewBag.TotalLibros</div>
                        <div class="text-muted small">Total Libros</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 fs-3">📋</div>
                    <div>
                        <div class="fs-2 fw-bold text-warning">@ViewBag.TotalPrestamos</div>
                        <div class="text-muted small">Total Préstamos</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-danger bg-opacity-10 p-3 fs-3">⏳</div>
                    <div>
                        <div class="fs-2 fw-bold text-danger">@ViewBag.PrestamosPendientes</div>
                        <div class="text-muted small">Préstamos Pendientes</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Accesos rápidos -->
    <h5 class="fw-semibold mb-3">Gestión del Sistema</h5>
    <div class="row g-3">
        <div class="col-md-4">
            <a asp-controller="Usuarios" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100 hover-shadow">
                    <div class="card-body text-center py-4">
                        <div class="fs-1 mb-2">👤</div>
                        <h5 class="fw-bold">Gestionar Usuarios</h5>
                        <p class="text-muted small mb-0">Administrar cuentas y roles</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Libros" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center py-4">
                        <div class="fs-1 mb-2">📖</div>
                        <h5 class="fw-bold">Catálogo de Libros</h5>
                        <p class="text-muted small mb-0">Ver y administrar libros</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Prestamos" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center py-4">
                        <div class="fs-1 mb-2">📋</div>
                        <h5 class="fw-bold">Préstamos</h5>
                        <p class="text-muted small mb-0">Ver todos los préstamos</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>
