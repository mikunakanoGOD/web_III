@model IEnumerable<gestion_biblioteca.Models.Libro>
@using gestion_biblioteca.Models
@{
    ViewData["Title"] = "Gestión de Libros";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">📖 Gestión de Libros</h2>
        <a asp-action="Create" class="btn btn-primary">+ Agregar Libro</a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Exito"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Título</th>
                            <th>Autor</th>
                            <th>Categoría</th>
                            <th>ISBN</th>
                            <th>Disponibles / Total</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.Titulo</strong></td>
                                <td>@item.Autor</td>
                                <td><span class="badge bg-secondary">@item.Categoria</span></td>
                                <td><small>@item.ISBN</small></td>
                                <td>@item.CantidadDisponible / @item.CantidadTotal</td>
                                <td>
                                    @if (item.Estado == EstadoLibro.Disponible)
                                    { <span class="badge bg-success">Disponible</span> }
                                    else if (item.Estado == EstadoLibro.Prestado)
                                    { <span class="badge bg-warning text-dark">Prestado</span> }
                                    else
                                    { <span class="badge bg-danger">No Disponible</span> }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
