@using gestion_biblioteca.Models
@{
    ViewData["Title"] = "Mi Dashboard";
    var usuario = ViewBag.Usuario as gestion_biblioteca.ViewModels.UsuarioSesionViewModel;
    var misPrestamos = ViewBag.MisPrestamos as List<Prestamo>;
}

<div class="container-fluid py-4">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Mi Panel</h2>
            <p class="text-muted mb-0">Bienvenido, @usuario?.NombreCompleto</p>
        </div>
        <span class="badge bg-info fs-6 px-3 py-2">Usuario</span>
    </div>

    <!-- Tarjetas de estadísticas -->
    <div class="row g-4 mb-4">
        <div class="col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 fs-3">📚</div>
                    <div>
                        <div class="fs-2 fw-bold text-success">@ViewBag.LibrosDisponibles</div>
                        <div class="text-muted small">Libros Disponibles</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 fs-3">📋</div>
                    <div>
                        <div class="fs-2 fw-bold text-primary">@ViewBag.TotalMisPrestamos</div>
                        <div class="text-muted small">Mis Préstamos</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Accesos rápidos -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <a asp-controller="Libros" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm">
                    <div class="card-body d-flex align-items-center gap-3 py-3">
                        <div class="fs-2">🔍</div>
                        <div>
                            <h6 class="fw-bold mb-0">Ver Catálogo</h6>
                            <small class="text-muted">Explorar libros disponibles</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-controller="Prestamos" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm">
                    <div class="card-body d-flex align-items-center gap-3 py-3">
                        <div class="fs-2">📋</div>
                        <div>
                            <h6 class="fw-bold mb-0">Mis Préstamos</h6>
                            <small class="text-muted">Ver el historial de mis préstamos</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Mis préstamos activos -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-3">
            <h5 class="fw-bold mb-0">📤 Mis Préstamos Activos</h5>
        </div>
        <div class="card-body p-0">
            @if (misPrestamos != null && misPrestamos.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Libro</th>
                                <th>Fecha Solicitud</th>
                                <th>Devolución Esperada</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in misPrestamos)
                            {
                                <tr>
                                    <td><strong>@p.Libro?.Titulo</strong><br/><small class="text-muted">@p.Libro?.Autor</small></td>
                                    <td>@p.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                                    <td>@(p.FechaDevolucionEsperada?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td>
                                        @if (p.Estado == EstadoPrestamo.Pendiente)
                                        {
                                            <span class="badge bg-warning text-dark">Pendiente</span>
                                        }
                                        else if (p.Estado == EstadoPrestamo.Aprobado)
                                        {
                                            <span class="badge bg-success">Aprobado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <div class="fs-1">📭</div>
                    <p>No tienes préstamos activos</p>
                    <a asp-controller="Libros" asp-action="Index" class="btn btn-primary btn-sm">
                        Ver Catálogo
                    </a>
                </div>
            }
        </div>
    </div>
</div>
