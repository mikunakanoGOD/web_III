@model gestion_biblioteca.Models.Usuario
@using gestion_biblioteca.Models
@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="container py-4" style="max-width:600px">
    <h2 class="fw-bold mb-4">👤 Crear Nuevo Usuario</h2>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Apellido" class="form-label fw-semibold"></label>
                        <input asp-for="Apellido" class="form-control" />
                        <span asp-validation-for="Apellido" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="PasswordHash" class="form-label fw-semibold">Contraseña</label>
                        <input asp-for="PasswordHash" type="password" class="form-control" placeholder="Mínimo 6 caracteres" />
                        <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Rol" class="form-label fw-semibold"></label>
                        <select asp-for="Rol" class="form-select"
                                asp-items="Html.GetEnumSelectList<Rol>()">
                            <option value="">-- Seleccione un rol --</option>
                        </select>
                        <span asp-validation-for="Rol" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input asp-for="Activo" class="form-check-input" />
                            <label asp-for="Activo" class="form-check-label fw-semibold">Activo</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">Crear Usuario</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
