@model IEnumerable<gestion_biblioteca.Models.Usuario>
@using gestion_biblioteca.Models
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">👥 Gestión de Usuarios</h2>
        <a asp-action="Create" class="btn btn-primary">+ Nuevo Usuario</a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Exito"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Registro</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="@(!item.Activo ? "table-secondary text-muted" : "")">
                                <td>@item.NombreCompleto</td>
                                <td>@item.Email</td>
                                <td>
                                    @switch (item.Rol)
                                    {
                                        case Rol.Administrador:
                                            <span class="badge bg-danger">Administrador</span>
                                            break;
                                        case Rol.Bibliotecario:
                                            <span class="badge bg-success">Bibliotecario</span>
                                            break;
                                        default:
                                            <span class="badge bg-info">Usuario</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (item.Activo)
                                    { <span class="badge bg-success">Activo</span> }
                                    else
                                    { <span class="badge bg-secondary">Inactivo</span> }
                                </td>
                                <td><small>@item.FechaRegistro.ToString("dd/MM/yyyy")</small></td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                                    @if (item.Activo)
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Desactivar</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
