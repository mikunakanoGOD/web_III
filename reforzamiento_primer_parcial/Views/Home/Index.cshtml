@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mb-5">
    <h1 class="display-4">Sistema de Gestión de Ventas</h1>
    <p class="lead">Gestione sus clientes, productos y ventas de manera eficiente</p>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-people"></i> Clientes
                </h5>
                <p class="card-text">
                    Administre la información de sus clientes, agregue nuevos contactos y mantenga actualizada su base de datos.
                </p>
                <a asp-controller="Clientes" asp-action="Index" class="btn btn-primary">
                    Ir a Clientes
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-box"></i> Productos
                </h5>
                <p class="card-text">
                    Gestione su catálogo de productos, controle el inventario y actualice precios en tiempo real.
                </p>
                <a asp-controller="Productos" asp-action="Index" class="btn btn-primary">
                    Ir a Productos
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-cart"></i> Ventas
                </h5>
                <p class="card-text">
                    Registre nuevas ventas, consulte el historial de transacciones y visualice los detalles de cada operación.
                </p>
                <a asp-controller="Ventas" asp-action="Index" class="btn btn-primary">
                    Ir a Ventas
                </a>
            </div>
        </div>
    </div>
</div>
