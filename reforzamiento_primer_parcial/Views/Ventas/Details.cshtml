@model reforzamiento_primer_parcial.Models.Venta

@{
    ViewData["Title"] = "Detalles de Venta";
}

<h1>Detalles de Venta</h1>

<div class="card mb-4">
    <div class="card-header">
        <h4>Información de la Venta</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID Venta</dt>
            <dd class="col-sm-9">@Model.Id</dd>
            
            <dt class="col-sm-3">Fecha</dt>
            <dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>
            
            <dt class="col-sm-3">Cliente</dt>
            <dd class="col-sm-9">@(Model.Cliente?.Nombre ?? "N/A")</dd>
            
            <dt class="col-sm-3">Email Cliente</dt>
            <dd class="col-sm-9">@(Model.Cliente?.Email ?? "N/A")</dd>
        </dl>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h4>Productos</h4>
    </div>
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio Unitario</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detalle in Model.Detalles)
                {
                    <tr>
                        <td>@(detalle.Producto?.Nombre ?? "N/A")</td>
                        <td>@detalle.Cantidad</td>
                        <td>@detalle.PrecioUnitario.ToString("C")</td>
                        <td>@detalle.Subtotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total:</th>
                    <th>@Model.Total.ToString("C")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
</div>
